{
  "name": "notemaker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "common": "rm -rf node_modules/ && sleep 10 && npm install --legacy-peer-deps && npm run podSetup",
    "cleanGradle": "cd android && ./gradlew clean && cd ../",
    "test": "jest",
    "podInstall": "cd ios && RCT_NEW_ARCH_ENABLED=1  ruby -S pod install && cd ../",
    "podUnInstall": "cd ios && pod deintegrate && cd ../",
    "podSetup": "npm run podUnInstall && npm run podInstall",
    "release": "cd android && ./gradlew clean && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/drawer": "7.5.7",
    "@react-navigation/native": "7.1.17",
    "@react-navigation/stack": "7.4.7",
    "axios": "1.9.0",
    "mobx": "6.13.7",
    "mobx-react-lite": "4.0.7",
    "moment": "2.30.1",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-native-codegen": "0.70.7",
    "react-native-config": "1.5.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-pell-rich-editor": "^1.10.0",
    "react-native-reanimated": "4.0.2",
    "react-native-safe-area-context": "5.4.1",
    "react-native-screens": "4.13.1",
    "react-native-toast-message": "2.3.3",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.4.1",
    "realm": "20.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@babel/preset-env": "7.26.9",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.3",
    "@react-native/eslint-config": "0.78.3",
    "@react-native/metro-config": "0.78.3",
    "@react-native/typescript-config": "0.78.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "3.3.2",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
